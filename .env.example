# Copy to .env and fill in. Never commit .env.

# --- OCR proxy (server/) ---
PORT=8787

# Where Gemma 4 runs: "ollama" (local, private) or "hosted" (Gemini API)
GEMMA_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# ollama: gemma4:e2b (fits ~8 GB RAM) or gemma4:e4b · hosted: gemma-4-26b-a4b-it
GEMMA_MODEL=gemma4:e2b

# Only for GEMMA_PROVIDER=hosted. Server-side only; never put it in a VITE_ variable.
GEMMA_API_KEY=

# Limits
MAX_IMAGE_BYTES=2000000
RATE_LIMIT_PER_MIN=10
MAX_CONCURRENT=2
OCR_TIMEOUT_MS=60000

# Comma-separated origins allowed to call the proxy from a deployed frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to 1 when running behind one reverse proxy (Render, Railway, nginx)
TRUST_PROXY=0

# --- Frontend (optional) ---
# Full URL of the proxy when it is not on the same origin, e.g. https://ocr.example.com
# VITE_API_BASE=
